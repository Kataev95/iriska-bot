# --- Обязательное ---

# Токен бота от @BotFather
BOT_TOKEN=

# --- Админы ---

# Telegram ID админов через запятую — надёжный способ (узнать ID: напиши боту /id в личку)
ADMIN_IDS=

# Username админов без @, через запятую (запасной способ)
ADMIN_USERNAMES=PabloSvytoy

# Кому писать для вывода (показывается участникам)
ADMIN_CONTACT=@PabloSvytoy

# --- Экономика ---

# 1 ириска за каждые N засчитанных сообщений (100 => 1000 сообщений = 10 ирисок)
MESSAGES_PER_IRISKA=100

# Минимум ирисок для вывода
WITHDRAW_THRESHOLD=300

# --- Антинакрутка ---

# Минимальная длина сообщения (символов)
MIN_MSG_LEN=3

# Не чаще одного зачёта в N секунд
COOLDOWN_SECONDS=5

# --- Прочее ---

# Путь к файлу базы (на Amvera поставь /data/iriski.db)
DB_PATH=data/iriski.db

# Часовой пояс для «сегодня» и «неделя»
BOT_TZ=Europe/Moscow
