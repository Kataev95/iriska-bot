# --- Обязательное ---

# Токен бота от @BotFather
BOT_TOKEN=

# --- Админы ---

# Telegram ID админов через запятую — надёжный способ (узнать ID: напиши боту /id в личку)
ADMIN_IDS=

# Username админов без @, через запятую (запасной способ)
ADMIN_USERNAMES=PabloSvytoy

# Кому писать для вывода (показывается участникам)
ADMIN_CONTACT=@PabloSvytoy

# --- Экономика ---

# 1 ириска за каждые N засчитанных сообщений (100 => 1000 сообщений = 10 ирисок)
MESSAGES_PER_IRISKA=100

# Минимум ирисок для вывода
WITHDRAW_THRESHOLD=300

# --- Игры и бонусы ---

# Ежедневный бонус: включён ли и размер (случайно от MIN до MAX)
BONUS_ENABLED=1
BONUS_MIN=1
BONUS_MAX=2

# Игры (казино и дуэли): 1 — включены, 0 — выключены
GAMES_ENABLED=1

# Казино: лимиты ставки и пауза между играми (секунд)
CASINO_MIN_BET=1
CASINO_MAX_BET=50
CASINO_COOLDOWN=30

# Дуэли: лимиты ставки и время жизни вызова (секунд)
DUEL_MIN_BET=1
DUEL_MAX_BET=100
DUEL_TTL=300

# --- Бонусные часы ---

# Окна часов, когда сообщения дают умноженный прогресс к ирискам
# Формат: 7-9,13-15,20-21 (конец окна не включается: 7-9 = с 07:00 до 08:59)
# Пустое значение = бонусных часов нет
BONUS_HOURS=7-9,13-15,20-21

# Множитель прогресса в бонусные часы
BONUS_HOURS_MULT=2

# Объявлять ли в чате о начале бонусного часа (1 — да, 0 — нет)
ANNOUNCE_BONUS_HOURS=1

# --- Антинакрутка (по умолчанию выключена) ---

# Минимальная длина сообщения в символах. 1 = считать любые
MIN_MSG_LEN=1

# Не чаще одного зачёта в N секунд. 0 = без ограничения
COOLDOWN_SECONDS=0

# Не засчитывать повтор одного и того же сообщения подряд. 1 = включить защиту
DEDUPE_REPEATS=0

# --- Прочее ---

# Путь к файлу базы (на Amvera поставь /data/iriski.db)
DB_PATH=data/iriski.db

# Часовой пояс для «сегодня» и «неделя»
BOT_TZ=Europe/Moscow
